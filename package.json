{
  "bin": {
    "vasir": "./bin/vasir.js"
  },
  "bundledDependencies": [
    "cli-spinners"
  ],
  "dependencies": {
    "cli-spinners": "3.4.0"
  },
  "description": "Local Vasir CLI with 67 canonical skills, including a gamedev group",
  "engines": {
    "node": "^18.20.0 || >=20.10.0"
  },
  "files": [
    "bin/",
    "cli/",
    "templates/",
    "scripts/build-agent-templates.js",
    "registry.json",
    ".vasir-catalog-manifest.json",
    "skill-groups.json",
    ".agents/skills/",
    ".agents/vasir.json",
    "AGENTS.md",
    "CLAUDE.md",
    "AGENTS__non-obvious.md",
    "LICENSE",
    "README.md",
    "PROVENANCE.md",
    "registry/build.js",
    "docs/*.md",
    "registry/review-metadata.json",
    "scripts/build-review-catalog.js",
    "docs/review/",
    "docs/work/agents/",
    ".agents/README.md",
    "MANIFESTO.md",
    "keys.json.example",
    "work/WORK.md",
    "registry/gamedev-imports.json"
  ],
  "keywords": [
    "llm",
    "skills",
    "agents",
    "claude",
    "codex",
    "prompt-engineering",
    "game-dev"
  ],
  "license": "MIT",
  "name": "vasir-slim",
  "private": true,
  "scripts": {
    "build:agents": "node scripts/build-agent-templates.js --write",
    "build:registry": "node registry/build.js --write",
    "check:agents": "node scripts/build-agent-templates.js --check",
    "check:registry": "node registry/build.js --check",
    "eval": "node cli/eval.js",
    "test": "node scripts/run-tests.js",
    "build:review": "node scripts/build-review-catalog.js --write",
    "check:review": "node scripts/build-review-catalog.js --check",
    "check:package": "node scripts/verify-package.js"
  },
  "type": "module",
  "version": "0.1.0-ml",
  "repository": {
    "type": "git",
    "url": "https://github.com/kosta-blank/vasirml.git"
  },
  "displayVersion": "0.1.ml"
}
